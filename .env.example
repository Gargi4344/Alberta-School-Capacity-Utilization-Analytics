# Copy to .env (`make setup` does this). Never commit .env.

# --- Database (docker-compose and the backend) ---
POSTGRES_USER=abcap
POSTGRES_PASSWORD=abcap
POSTGRES_DB=abcap
POSTGRES_PORT=5432
# Used by the backend and pipeline when run on the host (uv run ...).
DATABASE_URL=postgresql+psycopg://abcap:abcap@localhost:5432/abcap

# --- Backend ---
LOG_LEVEL=INFO
# Root of data/ (raw/ and sample/ live under it). Defaults to <repo>/data.
# DATA_DIR=./data

# --- Open data ---
CKAN_BASE_URL=https://open.alberta.ca/api/3/action
HTTP_TIMEOUT_SECONDS=120

# --- Business rules ---
# The province's optimal utilization rate; schools at or above it are flagged.
UTILIZATION_THRESHOLD_PCT=85
OVER_CAPACITY_PCT=100
